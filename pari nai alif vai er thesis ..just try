        "r_avg = sum(df2[e]*r for e,r in radii.items()) / 100\n",
        "df2['delta_r'] = np.sqrt(sum(\n",
        "    df2[e]/100 * (1 - radii[e]/r_avg)**2 for e,r in radii.items()\n",
