        "df['Cr_x_T'] = df['Cr (%)'] * df['Temp (K)']\n",
        "df['Mn_x_T'] = df['Mn (%)'] * df['Temp (K)']\n",
        "df['S_x_T']  = df['mixing_entropy'] * df['Temp (K)']\n",
        "df['VEC_x_T']= df['VEC'] * df['Temp (K)']\n",
        "\n",
        "# Temperature as categorical (one-hot)\n",
        "df['Temp_cat'] = df['Temp (K)'].astype(str)\n",
        "\n",
        "# ── Feature columns ───────────────────────────────────────────\n",
        "NUM_COLS = [\n",
        "    'Fe (%)','Cr (%)','Ni (%)','Mn (%)',\n",
        "    'Temp (K)',\n",
        "    'mixing_entropy','VEC','delta_r',\n",
        "    'Fe_x_T','Ni_x_T','Cr_x_T','Mn_x_T',\n",
        "    'S_x_T','VEC_x_T'\n",
        "]\n",
        "CAT_COLS  = ['Temp_cat']\n",
