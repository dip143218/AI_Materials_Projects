        "\n",
        "rdf = pd.DataFrame(results).sort_values('CV', ascending=False)\n",
        "print(f\"\\nBest: {best_model_name}  CV R²={best_cv_score:.4f}\")\n",
        "\n",
        "# ── Tune the best model ───────────────────────────────────────\n",
        "print(\"\\nTuning best model ...\")\n",
        "\n",
        "if 'GBR' in best_model_name:\n",
        "    param_grid = {\n",
