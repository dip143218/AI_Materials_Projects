        "# ============================================================\n",
        "# CELL 2: FEATURE ENGINEERING\n",
        "# ============================================================\n",
        "eps = 1e-6\n",
        "\n",
        "df_fe = df.copy()\n",
        "\n",
        "# ── composition ratios ───────────────────────────────────────\n",
        "df_fe['Fe_Cr_ratio']  = df_fe['Fe (%)'] / (df_fe['Cr (%)'] + eps)\n",
        "df_fe['Ni_Mn_ratio']  = df_fe['Ni (%)'] / (df_fe['Mn (%)'] + eps)\n",
        "\n",
        "# ── total alloy content ──────────────────────────────────────\n",
        "df_fe['total_alloy']  = (df_fe['Fe (%)'] + df_fe['Cr (%)'] +\n",
        "                          df_fe['Ni (%)'] + df_fe['Mn (%)'])\n",
        "\n",
        "# ── pairwise interactions ────────────────────────────────────\n",
        "df_fe['Fe_Ni_interact'] = df_fe['Fe (%)'] * df_fe['Ni (%)']\n",
        "df_fe['Cr_Mn_interact'] = df_fe['Cr (%)'] * df_fe['Mn (%)']\n",
        "df_fe['Temp_Ni']         = df_fe['Temp (K)'] * df_fe['Ni (%)']\n",
        "df_fe['Temp_Fe']         = df_fe['Temp (K)'] * df_fe['Fe (%)']\n",
        "df_fe['Temp_Cr']         = df_fe['Temp (K)'] * df_fe['Cr (%)']\n",
        "\n",
        "# ── alloy balance features ───────────────────────────────────\n",
        "df_fe['Fe_plus_Ni']  = df_fe['Fe (%)'] + df_fe['Ni (%)']\n",
        "df_fe['Cr_plus_Mn']  = df_fe['Cr (%)'] + df_fe['Mn (%)']\n",
        "df_fe['atomic_mismatch'] = (\n",
        "    abs(df_fe['Fe (%)'] - df_fe['Cr (%)']) +\n",
        "    abs(df_fe['Ni (%)'] - df_fe['Mn (%)'])\n",
        ")\n",
        "\n",
        "# ── temperature normalised by alloy content ──────────────────\n",
        "df_fe['Temp_norm'] = df_fe['Temp (K)'] / (df_fe['total_alloy'] + eps)\n",
        "\n",
        "# ── mixing entropy (Shannon, mole-fraction basis) ────────────\n",
        "#    R × Σ( xᵢ ln xᵢ )  — only composition columns\n",
        "comp_cols = ['Fe (%)', 'Cr (%)', 'Ni (%)', 'Mn (%)']\n",
        "frac = df_fe[comp_cols].div(df_fe[comp_cols].sum(axis=1), axis=0)\n",
        "df_fe['mixing_entropy'] = -(frac * np.log(frac + 1e-9)).sum(axis=1)\n",
        "\n",
        "# ── squared terms for nonlinearity (SAFE: no poly pipeline) ──\n",
        "df_fe['Ni_sq']   = df_fe['Ni (%)']   ** 2\n",
        "df_fe['Cr_sq']   = df_fe['Cr (%)']   ** 2\n",
        "df_fe['Temp_sq'] = df_fe['Temp (K)'] ** 2\n",
