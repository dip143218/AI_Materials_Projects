        "\n",
        "# Mixing entropy\n",
        "frac = df[comp_cols].div(df[comp_cols].sum(axis=1), axis=0)\n",
        "df['mixing_entropy'] = -(frac * np.log(frac + 1e-9)).sum(axis=1)\n",
        "\n",
        "# Valence electron concentration\n",
        "df['VEC'] = (df['Fe (%)']*8 + df['Cr (%)']*6 +\n",
        "             df['Ni (%)']*10 + df['Mn (%)']*7) / 100\n",
        "\n",
        "# Atomic size mismatch (Hume-Rothery)\n",
        "radii = {'Fe (%)':1.26,'Cr (%)':1.28,'Ni (%)':1.25,'Mn (%)':1.27}\n",
        "r_avg = sum(df[e]*r for e,r in radii.items()) / 100\n",
        "df['delta_r'] = np.sqrt(sum(\n",
        "    df[e]/100 * (1 - radii[e]/r_avg)**2 for e in radii\n",
        "))\n",
        "\n",
        "# ── CRITICAL: Temperature × Composition interactions ─────────\n",
        "# These capture HOW composition effect changes with temperature\n",
        "df['Fe_x_T'] = df['Fe (%)'] * df['Temp (K)']\n",
